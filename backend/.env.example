# Copie ce fichier en ".env" et adapte les valeurs.
# Chaine de connexion PostgreSQL : postgresql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/NOM_BASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sienv

# Cle secrete pour signer les jetons JWT (mets une longue chaine aleatoire en production)
SECRET_KEY=change-moi-avec-une-longue-chaine-aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=60
